[
  {
    "id": "lesson-01",
    "number": 1,
    "title": {
      "ja": "新しい 友達",
      "romaji": "Atarashii Tomodachi",
      "vi": "Bạn mới"
    },
    "description": {
      "vi": "Tự giới thiệu bản thân, hỏi tên, quốc tịch, nghề nghiệp. Sử dụng mẫu câu ～は ～です。",
      "en": "Self-introduction, asking about name, nationality, occupation. Using ～は ～です pattern.",
      "ja": "自己紹介"
    },
    "jlptLevel": "N5",
    "chapter": 1,
    "courseId": "minna-1",
    "vocabCount": 49,
    "grammarCount": 5,
    "kanjiCount": 10,
    "topics": [
      {
        "vi": "Giới thiệu bản thân",
        "en": "Self-introduction"
      },
      {
        "vi": "Quốc tịch và nghề nghiệp",
        "en": "Nationality and occupation"
      }
    ]
  },
  {
    "id": "lesson-02",
    "number": 2,
    "title": {
      "ja": "これは 何ですか",
      "romaji": "Kore wa Nan Desu ka",
      "vi": "Cái này là gì?"
    },
    "description": {
      "vi": "Sử dụng đại từ chỉ định これ/それ/あれ để xác định đồ vật. Hỏi tên, xuất xứ, sở hữu của đồ vật.",
      "en": "Using demonstrative pronouns これ/それ/あれ to identify objects. Asking about names, origins, and ownership.",
      "ja": "指示代名詞を使って物を特定する"
    },
    "jlptLevel": "N5",
    "chapter": 2,
    "courseId": "minna-1",
    "vocabCount": 42,
    "grammarCount": 4,
    "kanjiCount": 8,
    "topics": [
      {
        "vi": "Đại từ chỉ định (đồ vật)",
        "en": "Demonstrative pronouns (objects)"
      },
      {
        "vi": "Đồ vật hàng ngày",
        "en": "Everyday objects"
      }
    ]
  },
  {
    "id": "lesson-03",
    "number": 3,
    "title": {
      "ja": "ここは デパートです",
      "romaji": "Koko wa Depaato Desu",
      "vi": "Đây là cửa hàng bách hóa"
    },
    "description": {
      "vi": "Chỉ nơi chốn bằng ここ/そこ/あそこ. Hỏi giá tiền, mua sắm tại cửa hàng bách hóa. Hỏi xuất xứ sản phẩm.",
      "en": "Indicating places with ここ/そこ/あそこ. Asking prices, shopping at department stores. Asking product origins.",
      "ja": "場所を指し示す。買い物をする"
    },
    "jlptLevel": "N5",
    "chapter": 3,
    "courseId": "minna-1",
    "vocabCount": 40,
    "grammarCount": 4,
    "kanjiCount": 8,
    "topics": [
      {
        "vi": "Nơi chốn và phương hướng",
        "en": "Places and directions"
      },
      {
        "vi": "Mua sắm và giá cả",
        "en": "Shopping and prices"
      }
    ]
  },
  {
    "id": "lesson-04",
    "number": 4,
    "title": {
      "ja": "何時に 起きますか",
      "romaji": "Nanji ni Okimasu ka",
      "vi": "Mấy giờ bạn dậy?"
    },
    "description": {
      "vi": "Nói giờ giấc, thời gian biểu hàng ngày. Chia động từ thể ます (khẳng định, phủ định, quá khứ). Dùng から〜まで chỉ khoảng thời gian.",
      "en": "Telling time, daily schedules. Conjugating verbs in ます form (affirmative, negative, past). Using から〜まで for time ranges.",
      "ja": "時刻を言う。動詞のます形。日常のスケジュール"
    },
    "jlptLevel": "N5",
    "chapter": 4,
    "courseId": "minna-1",
    "vocabCount": 42,
    "grammarCount": 4,
    "kanjiCount": 8,
    "topics": [
      {
        "vi": "Thời gian và giờ giấc",
        "en": "Time and schedules"
      },
      {
        "vi": "Động từ thể ます",
        "en": "Verb ます form"
      }
    ]
  },
  {
    "id": "lesson-05",
    "number": 5,
    "title": {
      "ja": "京都へ 行きます",
      "romaji": "Kyouto e Ikimasu",
      "vi": "Đi đến Kyoto"
    },
    "description": {
      "vi": "Di chuyển bằng 行きます/来ます/帰ります. Phương tiện giao thông với で. Đi cùng ai với と. Hỏi khi nào với いつ.",
      "en": "Movement verbs 行きます/来ます/帰ります. Transportation with で. Going with someone using と. Asking when with いつ.",
      "ja": "移動動詞。交通手段。いつ"
    },
    "jlptLevel": "N5",
    "chapter": 5,
    "courseId": "minna-1",
    "vocabCount": 34,
    "grammarCount": 4,
    "kanjiCount": 8,
    "topics": [
      {
        "vi": "Di chuyển và giao thông",
        "en": "Movement and transportation"
      },
      {
        "vi": "Thời gian (tuần, tháng, năm)",
        "en": "Time periods (week, month, year)"
      }
    ]
  },
